<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/title_bar"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="13dp"
    android:paddingEnd="12dp"
    android:paddingBottom="13dp">

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_title_bar_button"
        android:contentDescription="@string/back"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_arrow_back"
        android:stateListAnimator="@null"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/appIconImageView"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/app_icon"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/mapLayersButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_title_bar_button"
        android:backgroundTint="@null"
        android:contentDescription="@string/map_layers"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/map2"
        android:stateListAnimator="@null" />

    <ImageButton
        android:id="@+id/themeToggleButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_title_bar_button"
        android:backgroundTint="@null"
        android:contentDescription="@string/change_theme"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:stateListAnimator="@null"
        android:src="@drawable/theme_sun" />

    <ImageButton
        android:id="@+id/languageFlag"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_title_bar_button"
        android:backgroundTint="@null"
        android:contentDescription="@string/change_language"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:stateListAnimator="@null"
        android:src="@drawable/flag_us" />
</LinearLayout>
